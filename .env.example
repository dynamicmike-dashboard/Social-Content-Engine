# Social Content Engine - Vercel Environment Configuration
# Copy this to .env.local for local development
# Set these in Vercel Project Settings > Environment Variables

# ==========================================
# TEABLE DATABASE (Server-side only - NO VITE_ prefix)
# ==========================================
TEABLE_API_BASE=https://app.teable.ai/api
TEABLE_BASE_ID=bseagIh2WI3tU9zIvKm
TEABLE_API_TOKEN=your_teable_personal_access_token_here

# Table IDs (from verified schema)
TEABLE_CLIENTS_TABLE_ID=tblEwplxQKUmq9oDHki
TEABLE_QUESTIONNAIRE_TABLE_ID=tblknwlbpM85PW6tDN2
TEABLE_STRATEGIES_TABLE_ID=tblFGUZ06SPGwjmLEXB
TEABLE_CONTENT_CALENDAR_TABLE_ID=tblza9csBxLaPAkRkQS
TEABLE_CONTENT_ASSETS_TABLE_ID=tblfFIwp5wnhnJqmiUB
TEABLE_APPROVAL_ACTIVITY_TABLE_ID=tble7rdBSzvUnIl7x1p

# Future features
TEABLE_SOCIAL_ACCOUNTS_TABLE_ID=tbljhokUm3ToWSGg2y5
TEABLE_LEADS_TABLE_ID=tblClVGoMgC8MtKlaLX

# Optional view references
TEABLE_CALENDAR_VIEW_ID=viw9iU5TqUsxQjK8MN2
TEABLE_CLIENT_REVIEW_VIEW_ID=viwP1MP1qeel7Zjm0ix

# ==========================================
# APPLICATION
# ==========================================
APP_URL=https://your-app.vercel.app
DEFAULT_TIME_ZONE=America/Cancun

# ==========================================
# DEMO MODE (Public - safe for client bundle)
# ==========================================
VITE_DEMO_ENABLED=true

# ==========================================
# AUTHENTICATION (Add based on your provider)
# ==========================================
# Example for Clerk:
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Example for NextAuth:
# NEXTAUTH_SECRET=your_secret_here
# NEXTAUTH_URL=https://your-app.vercel.app

# ==========================================
# AI GENERATION PROVIDERS (Add based on your choices)
# ==========================================
# Text generation (e.g., OpenRouter, Anthropic, OpenAI)
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Image generation (e.g., OpenAI DALL-E, Replicate, Fal.ai)
# REPLICATE_API_TOKEN=...
# FAL_API_KEY=...

# Video generation (e.g., Runway, Pika, Replicate)
# RUNWAY_API_KEY=...

# ==========================================
# DURABLE QUEUE / WORKER (Add based on your choice)
# ==========================================
# Upstash Redis (for BullMQ or custom queue)
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# Or Vercel Cron / Inngest / Trigger.dev
# INNGEST_EVENT_KEY=...
# TRIGGER_SECRET_KEY=...

# ==========================================
# MEDIA STORAGE (Add based on your choice)
# ==========================================
# AWS S3 / Cloudflare R2 / Supabase Storage
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=social-content-assets
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=social-content-assets

# ==========================================
# TRANSACTIONAL EMAIL (Add if needed)
# ==========================================
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# ==========================================
# FEATURE FLAGS
# ==========================================
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false